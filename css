/* ============================================================
   VARIABLES & RESET
============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:         hsl(10, 8%, 8%);
  --bg-card:    hsl(10, 8%, 10%);
  --fg:         hsl(40, 30%, 90%);
  --fg-muted:   hsla(40, 30%, 90%, 0.6);
  --primary:    hsl(345, 40%, 35%);
  --primary-fg: hsl(40, 30%, 90%);
  --gold:       hsl(40, 60%, 55%);
  --border:     hsl(10, 8%, 15%);

  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans:  'Lato', system-ui, sans-serif;
}

html { scroll-behavior: smooth; }

body {
  background-color: var(--bg);
  color: var(--fg);
  font-family: var(--sans);
  font-weight: 300;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--serif);
  font-weight: 500;
}

img { display: block; max-width: 100%; }

/* ============================================================
   UTILITIES
============================================================ */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.section-label {
  display: block;
  font-family: var(--serif);
  font-style: italic;
  font-size: 1.2rem;
  color: var(--gold);
  margin-bottom: 1rem;
}

.section-title {
  font-family: var(--serif);
  font-size: clamp(2rem, 5vw, 3rem);
  color: var(--fg);
  margin-bottom: 1.5rem;
}

.divider {
  width: 4rem;
  height: 1px;
  background: var(--gold);
  margin: 0 auto 4rem;
}

.section-head { text-align: center; }

/* Scroll reveal animations */
.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal.visible { opacity: 1; transform: translateY(0); }

.reveal-left {
  opacity: 0;
  transform: translateX(-40px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal-left.visible { opacity: 1; transform: translateX(0); }

.reveal-right {
  opacity: 0;
  transform: translateX(40px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal-right.visible { opacity: 1; transform: translateX(0); }

/* ============================================================
   NAVBAR
============================================================ */
#navbar {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 100;
  padding: 1.5rem 0;
  transition: background 0.5s ease, padding 0.4s ease, border-color 0.5s;
  border-bottom: 1px solid transparent;
}
#navbar.scrolled {
  background: hsla(10, 8%, 8%, 0.95);
  backdrop-filter: blur(8px);
  padding: 0.75rem 0;
  border-bottom-color: var(--border);
}
#navbar .inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
#navbar .logo img {
  height: 3.5rem;
  width: auto;
  border-radius: 4px;
  object-fit: cover;
  transition: height 0.4s;
  cursor: pointer;
}
#navbar.scrolled .logo img { height: 2.5rem; }

#navbar nav {
  display: flex;
  align-items: center;
  gap: 2rem;
  font-family: var(--serif);
  font-size: 1.1rem;
  letter-spacing: 0.05em;
}
#navbar nav a {
  color: hsla(40, 30%, 90%, 0.8);
  text-decoration: none;
  transition: color 0.3s;
}
#navbar nav a:hover { color: var(--gold); }

.btn-nav-reserve {
  padding: 0.5rem 1.25rem;
  border: 1px solid var(--gold) !important;
  color: var(--gold) !important;
  transition: background 0.3s, color 0.3s !important;
}
.btn-nav-reserve:hover {
  background: var(--gold) !important;
  color: var(--bg) !important;
}

/* Mobile hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  background: none;
  border: none;
  padding: 4px;
}
.hamburger span {
  display: block;
  width: 26px;
  height: 1px;
  background: var(--fg);
  transition: all 0.3s;
}

@media (max-width: 768px) {
  .hamburger { display: flex; }
  #navbar nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: hsla(10, 8%, 8%, 0.98);
    flex-direction: column;
    padding: 2rem;
    gap: 1.5rem;
    border-top: 1px solid var(--border);
  }
  #navbar nav.open { display: flex; }
}

/* ============================================================
   HERO
============================================================ */
#hero {
  position: relative;
  height: 100vh;
  min-height: 600px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-align: center;
}
#hero .hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
#hero .hero-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
#hero .hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    hsla(10, 8%, 8%, 0.4),
    hsla(10, 8%, 8%, 0.65) 50%,
    var(--bg) 100%
  );
}
#hero .hero-content {
  position: relative;
  z-index: 1;
  padding: 0 1.5rem;
  animation: heroFade 1.2s ease both;
}
@keyframes heroFade {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
#hero .hero-subtitle {
  font-family: var(--serif);
  font-style: italic;
  font-size: 1.3rem;
  color: var(--gold);
  letter-spacing: 0.1em;
  margin-bottom: 1.25rem;
}
#hero h1 {
  font-family: var(--serif);
  font-size: clamp(3rem, 10vw, 7rem);
  color: var(--fg);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  line-height: 1.05;
}
#hero .hero-line {
  width: 5rem;
  height: 1px;
  background: var(--gold);
  margin: 2rem auto;
}
#hero .hero-tagline {
  font-size: 1.1rem;
  color: hsla(40, 30%, 90%, 0.8);
  max-width: 480px;
  margin: 0 auto 2.5rem;
  line-height: 1.7;
}
.hero-buttons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}
.btn-primary {
  padding: 1rem 2.5rem;
  background: var(--primary);
  color: var(--primary-fg);
  font-family: var(--serif);
  font-size: 1.05rem;
  letter-spacing: 0.08em;
  border: 1px solid var(--primary);
  cursor: pointer;
  text-decoration: none;
  transition: background 0.3s;
  display: inline-block;
}
.btn-primary:hover { background: hsl(345, 40%, 28%); }

.btn-outline {
  padding: 1rem 2.5rem;
  background: transparent;
  color: var(--fg);
  font-family: var(--serif);
  font-size: 1.05rem;
  letter-spacing: 0.08em;
  border: 1px solid hsla(40, 30%, 90%, 0.3);
  cursor: pointer;
  text-decoration: none;
  transition: background 0.3s;
  display: inline-block;
}
.btn-outline:hover { background: hsla(255, 255, 255, 0.05); }

/* Scroll indicator */
.scroll-indicator {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  animation: fadeIn 1s 2s both;
  z-index: 1;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.scroll-indicator span {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: hsla(40, 30%, 90%, 0.5);
}
.scroll-line {
  width: 1px;
  height: 3rem;
  background: hsla(40, 30%, 90%, 0.2);
  position: relative;
  overflow: hidden;
}
.scroll-line::after {
  content: '';
  position: absolute;
  top: -50%;
  left: 0;
  width: 100%;
  height: 50%;
  background: var(--gold);
  animation: scrollDrop 2s ease-in-out infinite;
}
@keyframes scrollDrop {
  0%   { top: -50%; }
  100% { top: 100%; }
}

/* ============================================================
   ABOUT
============================================================ */
#about {
  padding: 7rem 0;
  background: var(--bg);
  border-top: 1px solid var(--border);
}
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: center;
}
@media (max-width: 900px) {
  .about-grid { grid-template-columns: 1fr; }
}
.about-photos { position: relative; }
.about-photo-main {
  width: 100%;
  max-width: 420px;
  aspect-ratio: 3/4;
  object-fit: cover;
  box-shadow: 0 25px 60px rgba(0,0,0,0.5);
}
.about-photo-secondary {
  position: absolute;
  bottom: -2rem;
  right: -2rem;
  width: 55%;
  aspect-ratio: 1;
  object-fit: cover;
  border: 4px solid var(--bg);
  box-shadow: 0 15px 40px rgba(0,0,0,0.4);
}
@media (max-width: 768px) {
  .about-photo-secondary { display: none; }
}
.about-text h2 { margin-bottom: 2rem; line-height: 1.2; }
.about-text .prose {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  font-size: 1.05rem;
  color: var(--fg-muted);
  line-height: 1.8;
}
.about-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  margin-top: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border);
}
.about-stats h3 {
  font-family: var(--serif);
  font-size: 1.6rem;
  color: var(--gold);
  margin-bottom: 0.35rem;
}
.about-stats p { font-size: 0.85rem; color: var(--fg-muted); }

/* ============================================================
   MENU
============================================================ */
#menu {
  padding: 7rem 0;
  background: var(--bg-card);
  border-top: 1px solid var(--border);
}
.menu-columns {
  column-count: 2;
  column-gap: 4rem;
}
@media (max-width: 768px) {
  .menu-columns { column-count: 1; }
}
.menu-category {
  break-inside: avoid;
  margin-bottom: 3.5rem;
}
.menu-category h3 {
  font-family: var(--serif);
  font-size: 1.8rem;
  color: var(--primary);
  padding-bottom: 0.75rem;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid hsla(10, 8%, 40%, 0.3);
}
.menu-item {
  margin-bottom: 1.25rem;
  opacity: 0;
  transform: translateY(15px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.menu-item.visible { opacity: 1; transform: translateY(0); }
.menu-item-row {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
}
.menu-item-name {
  font-family: var(--serif);
  font-size: 1.15rem;
  color: var(--fg);
  white-space: nowrap;
}
.menu-item-dots {
  flex: 1;
  border-bottom: 1px dotted var(--border);
  margin-bottom: 4px;
  min-width: 20px;
}
.menu-item-price {
  font-family: var(--sans);
  font-size: 1rem;
  font-weight: 400;
  color: var(--gold);
  white-space: nowrap;
}
.menu-item-desc {
  font-size: 0.82rem;
  color: var(--fg-muted);
  font-style: italic;
  margin-top: 0.2rem;
}
.menu-note {
  font-size: 0.85rem;
  color: var(--fg-muted);
  font-style: italic;
  break-inside: avoid;
}

/* ============================================================
   GALLERY
============================================================ */
#gallery {
  padding: 7rem 0;
  background: var(--bg);
  border-top: 1px solid var(--border);
  overflow: hidden;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-auto-rows: 420px;
  gap: 1rem;
}
@media (max-width: 768px) {
  .gallery-grid {
    grid-template-columns: 1fr;
    grid-auto-rows: 300px;
  }
}
.gallery-item {
  position: relative;
  overflow: hidden;
  cursor: pointer;
}
.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s ease;
}
.gallery-item:hover img { transform: scale(1.05); }
.gallery-item .overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.2);
  opacity: 0;
  transition: opacity 0.5s;
}
.gallery-item:hover .overlay { opacity: 1; }
.g-wide   { grid-column: span 8; }
.g-narrow { grid-column: span 4; }
.g-full   { grid-column: span 12; height: 350px; }
@media (max-width: 768px) {
  .g-wide, .g-narrow, .g-full { grid-column: span 1; height: 300px; }
}

/* ============================================================
   RESERVATIONS
============================================================ */
#reservations {
  padding: 7rem 0;
  background: var(--bg-card);
  border-top: 1px solid var(--border);
}
.res-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
}
@media (max-width: 900px) {
  .res-grid { grid-template-columns: 1fr; }
}
.reservation-info h2 { margin-bottom: 1.5rem; }
.reservation-info .intro {
  font-size: 1.05rem;
  color: var(--fg-muted);
  line-height: 1.8;
  margin-bottom: 3rem;
  max-width: 400px;
}
.info-block { margin-bottom: 2rem; }
.info-block h4 {
  font-family: var(--serif);
  font-size: 1.4rem;
  color: var(--gold);
  margin-bottom: 0.4rem;
}
.info-block p { color: var(--fg-muted); line-height: 1.7; }

.booking-form-wrap {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 3rem;
  box-shadow: 0 25px 60px rgba(0,0,0,0.3);
}
.booking-form-wrap h3 {
  font-family: var(--serif);
  font-size: 1.8rem;
  text-align: center;
  margin-bottom: 2rem;
  color: var(--fg);
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}
@media (max-width: 600px) {
  .form-grid { grid-template-columns: 1fr; }
  .booking-form-wrap { padding: 1.75rem; }
}
.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
.form-group label {
  font-size: 0.78rem;
  color: var(--fg-muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.form-group input,
.form-group select {
  background: transparent;
  border: 1px solid hsla(10, 8%, 40%, 0.5);
  color: var(--fg);
  padding: 0.65rem 0.8rem;
  font-family: var(--sans);
  font-size: 0.95rem;
  outline: none;
  transition: border-color 0.3s;
  appearance: none;
  -webkit-appearance: none;
}
.form-group input:focus,
.form-group select:focus { border-color: var(--gold); }
.form-group select option { background: hsl(10, 8%, 12%); color: var(--fg); }
.form-group input::placeholder { color: hsla(40, 30%, 90%, 0.3); }
.form-group input[type="date"]::-webkit-calendar-picker-indicator,
.form-group input[type="time"]::-webkit-calendar-picker-indicator {
  filter: invert(0.7); cursor: pointer;
}
.form-error {
  font-size: 0.78rem;
  color: hsl(0, 70%, 60%);
  margin-top: 0.2rem;
  display: none;
}
.form-error.show { display: block; }

.btn-submit {
  width: 100%;
  padding: 1.1rem;
  background: var(--primary);
  color: var(--primary-fg);
  font-family: var(--serif);
  font-size: 1.15rem;
  letter-spacing: 0.1em;
  border: none;
  cursor: pointer;
  margin-top: 1rem;
  transition: background 0.3s;
}
.btn-submit:hover { background: hsl(345, 40%, 28%); }

/* ============================================================
   TOAST
============================================================ */
.toast {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-left: 3px solid var(--gold);
  padding: 1.25rem 1.75rem;
  font-family: var(--sans);
  max-width: 340px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  z-index: 200;
  transform: translateX(110%);
  transition: transform 0.4s ease;
}
.toast.show { transform: translateX(0); }
.toast-title { font-weight: 700; margin-bottom: 0.25rem; color: var(--fg); }
.toast-msg   { font-size: 0.88rem; color: var(--fg-muted); }

/* ============================================================
   FOOTER
============================================================ */
footer {
  padding: 4rem 0;
  background: var(--bg);
  border-top: 1px solid var(--border);
  text-align: center;
}
.foot-inner { display: flex; flex-direction: column; align-items: center; }
.foot-logo {
  height: 5rem;
  width: auto;
  object-fit: cover;
  border-radius: 4px;
  opacity: 0.9;
  margin-bottom: 2rem;
}
.foot-links {
  display: flex;
  justify-content: center;
  gap: 2.5rem;
  font-family: var(--serif);
  font-size: 1.05rem;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
}
.foot-links a {
  color: var(--fg-muted);
  text-decoration: none;
  transition: color 0.3s;
}
.foot-links a:hover { color: var(--gold); }
.foot-copy {
  font-size: 0.82rem;
  color: hsla(40, 30%, 90%, 0.3);
  line-height: 1.7;
  max-width: 400px;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
}
